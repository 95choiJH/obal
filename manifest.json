{
  "manifest_version": 3,
  "name": "오뱅알",
  "version": "1.0.0",
  "description": "치지직 스트리머 '따효니'님의 방송 일정을 채널 페이지에 표시하는 확장 프로그램입니다.",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://ggebdrlvzrgoyumlrnxe.supabase.co/*"
  ],
  "action": {
    "default_title": "오뱅알",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chzzk.naver.com/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/on_break.png",
        "icons/on_break-white.png",
        "icons/undetermined.png",
        "icons/undetermined-white.png",
        "icons/naver_cafe.png",
        "icons/video_donation.png",
        "icons/gamepad-icon.svg",
        "icons/calendar-icon.svg"
      ],
      "matches": [
        "https://chzzk.naver.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "obaengal@obal.com",
      "strict_min_version": "121.0"
    }
  }
}
